# Copy to .env.local and fill in. .env.local is gitignored; this file is not, so never
# put a real value in it.
#
# Everything here is EXPO_PUBLIC_*, which means it is inlined into the app bundle and is
# readable by anyone who downloads the app. Only values that are safe to publish belong
# in this file. Service-role keys and provider secrets go in server/.env, never here.
#
# Expo bakes these in at bundle time: after changing one, restart with
#   npx expo start --clear

# ── Supabase ───────────────────────────────────────────────────────────────────
#
# Local (npm run db:start, then npm run db:status for the values):
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54721
# 127.0.0.1 resolves to the phone itself, so a physical device needs either your
# machine's LAN address (http://192.168.x.x:54721) or a hosted project. A hosted project
# is the easier of the two — it is https, so neither iOS ATS nor Android cleartext
# blocking gets in the way.
#
# Hosted: Supabase dashboard → Project Settings → API.
#   URL is https://<project-ref>.supabase.co
#   The key is the one labelled "anon public", or "publishable" on newer projects.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Sentry (optional) ──────────────────────────────────────────────────────────
#
# Leave empty to keep error reporting off — the SDK is never even loaded without it.
# Requires a development build; @sentry/react-native is native and does not exist in
# Expo Go. See lib/observability.ts.
EXPO_PUBLIC_SENTRY_DSN=

# ── API service (phase 3) ──────────────────────────────────────────────────────
#
# Where `server/` is running. Optional: leave it empty and everything except commenting and
# verification keeps working, because those two are the only features that need a secret —
# a moderation classifier and an email provider. See PHASE3.md §8.
#
# Local:  leave this blank. In development the app derives the API host from the Metro
# bundler's own address and assumes port 8787 (`lib/env.ts`), so a physical device works with
# nothing set here and keeps working across Wi-Fi changes. Set it only to reach a service the
# bundler is not hosting — a deployment, a tunnel, or a different port. Note that 127.0.0.1
# means the phone itself, so it is never the right answer for a physical device.
EXPO_PUBLIC_API_URL=

# Overrides only the port of the derived dev URL above. Match `PORT` in server/.env.
# EXPO_PUBLIC_API_PORT=8787

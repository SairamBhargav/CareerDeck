# Copy to server/.env and fill in. server/.env is gitignored.
#
# Nothing here is public. SUPABASE_SERVICE_ROLE_KEY bypasses every RLS policy in the
# database — it must never be committed, and never sent to the app.
#
# Local values come from `npm run db:status` in the repo root.
# Hosted values come from the Supabase dashboard → Project Settings → API.

PORT=8787
NODE_ENV=development

SUPABASE_URL=http://127.0.0.1:54721
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Separate from the app's DSN so client and server errors stay distinguishable.
SENTRY_DSN=

# ── Moderation (phase 3, §10) ──────────────────────────────────────────────────
#
# The classifier in the comment write path. Everything below this line is optional, and
# `GET /health` reports which capabilities are actually live — see server/src/env.ts.
#
# **Without ANTHROPIC_API_KEY, commenting still works**: the doxxing regex and the threat
# lexicon still run, and anything they do not catch is published as `flagged` and queued for
# a human instead of being classified. That is the right behaviour for local development and
# the wrong behaviour for real users, so the server warns about it on every boot.
ANTHROPIC_API_KEY=

# §10 budgets 50–200ms for the classifier call. Claude Opus 5 with adaptive thinking does not
# fit that at p95; claude-haiku-4-5 does, for less money and some accuracy. The default is the
# more capable model — measure your own p95 before changing it, and read PHASE3.md §6.2 first.
# MODERATION_MODEL=claude-haiku-4-5
#
# How long to wait before giving up and publishing as `flagged` instead. Fail-open-but-reviewed:
# a slow model must not stop a verified student from answering a question.
# MODERATION_TIMEOUT_MS=2500

# ── Verification (phase 3, §3.2) ───────────────────────────────────────────────
#
# The .edu path emails a six-digit code to an address that is NOT the account's login address,
# which is why Supabase Auth cannot send it (see server/src/mail.ts).
#
# Without RESEND_API_KEY and NODE_ENV=development, the code comes back in the response so the
# flow is testable on a fresh clone. In production that is refused outright.
RESEND_API_KEY=
VERIFICATION_FROM_EMAIL=CareerDeck <verify@yourdomain.com>

# The personhood check. §3.2's ID path — the sibling of the .edu path, for the bootcamp grad,
# the career switcher, and the student whose university uses a .ac.uk-style domain.
#
# PERSONA_WEBHOOK_SECRET is what stops anyone from POSTing themselves a verified tier. Without
# it the webhook refuses every request, which is the only safe default for an unauthenticated
# endpoint that grants a privilege.
PERSONA_TEMPLATE_ID=
PERSONA_ENVIRONMENT_ID=
PERSONA_WEBHOOK_SECRET=

# Pepper for the credential digests in `verification_blocklist`, which is what makes a ban mean
# something: the same .edu address or the same government ID cannot verify a second account.
#
# It must match between this service and the database function that computes the same digest, so
# changing it un-bans everyone banned under the old value. Treat that as a data migration.
VERIFICATION_PEPPER=careerdeck-verification

# ── Resumes (phase 4, §3.9) ────────────────────────────────────────────────────
#
# Parsing reuses ANTHROPIC_API_KEY above — one credential, two features. Without it a resume
# still uploads and still sits on the shelf; it just never gets read, so there is no match
# score. `GET /health` reports `resumeParsing` and `resumeEncryption` separately, because they
# fail differently and the app shows different things.

# The extractor's model. Overridable, but the trade runs the opposite way to MODERATION_MODEL
# above: a parse happens once per uploaded document behind a progress state, not in front of a
# user staring at a composer, so accuracy is worth more than latency. Read PHASE4.md §5 first.
# RESUME_PARSER_MODEL=claude-opus-5
#
# Generous next to the classifier's 2.5s. Reading several rendered pages of a two-column layout
# is a different task from reading one sentence.
# RESUME_PARSE_TIMEOUT_MS=90000

# Seals resume_profiles.full_name_enc, email_enc and phone_enc with AES-256-GCM. 32 bytes of
# base64:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# **Rotating this destroys data.** Every field sealed under the old key becomes permanently
# unreadable and nothing detects it — the rows are still there and still the right length. Same
# class of hazard as VERIFICATION_PEPPER above and strictly worse: a lost pepper un-bans people,
# a lost key loses the plaintext for good. Treat a change as a data migration.
#
# Optional. Without it a resume parses and matches normally and the three contact fields are
# dropped rather than stored in the clear.
RESUME_ENCRYPTION_KEY=

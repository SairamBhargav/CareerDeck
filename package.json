{
  "name": "careerdeck",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:push": "supabase db push",
    "db:maintain": "node --env-file-if-exists=server/.env scripts/maintain.mjs",
    "seed:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-seed.ts",
    "types:generate": "node scripts/generate-types.mjs",
    "verify:phase0": "node scripts/verify-phase0.mjs",
    "verify:phase1": "node scripts/verify-phase1.mjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "server:dev": "npm --prefix server run dev",
    "ingest": "node --env-file-if-exists=server/.env server/src/ingest/run.ts",
    "ingest:sweep": "node --env-file-if-exists=server/.env server/src/ingest/run.ts --sweep"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.2",
    "aes-js": "^3.1.2",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.17",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.2",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3"
  }
}
